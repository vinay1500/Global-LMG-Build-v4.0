{
  "name": "global-lmg-api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "fx:refresh": "tsx src/scripts/refreshFxRates.ts",
    "migrate": "tsx src/scripts/runMigrations.ts",
    "migrate:prod": "node dist/scripts/runMigrations.js",
    "smoke:rate-limit": "tsx src/scripts/rateLimitSmoke.ts",
    "smoke:sentry": "tsx src/scripts/sentrySmoke.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sentry/node": "^10.52.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "mysql2": "^3.15.2",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.18.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^25.5.0",
    "@types/pdfkit": "^0.17.5",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2"
  }
}
