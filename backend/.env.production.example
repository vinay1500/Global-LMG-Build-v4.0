APP_ENV=production
LOG_LEVEL=info
REQUEST_LOGGING_ENABLED=true
PORT=3001
PUBLIC_WEB_ORIGIN=https://app.globallmg.org
AUTH_STORE_MODE=mysql
DASHBOARD_STORE_MODE=mysql
HEALTHCHECK_REQUIRE_MYSQL=true
SESSION_COOKIE_NAME=global_lmg_session
AUTH_FLOW_COOKIE_NAME=global_lmg_auth_flow
CSRF_COOKIE_NAME=global_lmg_csrf
AUTH_SESSION_SECRET=replace-with-a-64-character-random-secret
SESSION_TTL_HOURS=12
REMEMBER_ME_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_MINUTES=15
PHONE_OTP_TTL_MINUTES=10
PASSWORD_RESET_TTL_MINUTES=15
AUTH_FLOW_TTL_MINUTES=30
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
EMAIL_PROVIDER_MODE=resend
SMS_PROVIDER_MODE=twilio-verify
GOOGLE_AUTH_MODE=google-jwt
EMAIL_FROM_ADDRESS=Global LMG <no-reply@mail.globallmg.org>
RESEND_API_KEY=replace-me
TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_VERIFY_SERVICE_SID=replace-me
GOOGLE_CLIENT_ID=replace-me
MYSQL_HOST=127.0.0.1
MYSQL_CONNECTION_TIMEOUT_MS=5000
MYSQL_PORT=3306
MYSQL_DATABASE=global_lmg
MYSQL_USER=global_lmg_app
MYSQL_PASSWORD=replace-me
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_ROOT=/srv/global-lmg/uploads
DOCUMENT_UPLOAD_MAX_BYTES=26214400
SHUTDOWN_TIMEOUT_MS=15000
